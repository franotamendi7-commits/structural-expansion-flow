//@version=5
strategy("VWAP Breakout Strategy",
  overlay=true,
  initial_capital=500,
  default_qty_type=strategy.percent_of_equity,
  default_qty_value=100,
  commission_type=strategy.commission.percent,
  commission_value=0.05,
  pyramiding=0,
  format=format.price,
  precision=2,
  max_labels_count=500,
  max_lines_count=500)

// ─── Description ───
// VWAP Breakout Strategy — institutional-grade mean-reversion breakout
// on 15m timeframe. Enters when price deviates beyond VWAP threshold,
// exits with scaled targets and trailing stop.
//
// Live signals (free): https://t.me/vwapsignals

// ───── Inputs ─────
vwap_len   = input.int(12,     "VWAP Period")
dev_thr    = input.float(1.0,  "Deviation Entry (%)")
sl_atr     = input.float(2.0,  "Stop Loss (×ATR)")
tp_atr     = input.float(2.0,  "Take Profit (×ATR)")
atr_len    = input.int(14,     "ATR Period")
show_bands = input.bool(true,  "Show Deviation Bands")
show_equity = input.bool(true, "Show Equity Curve (lower pane)")

// ───── Calculations ─────
tp = (high + low + close) / 3
vp = tp * volume
vwap_val = ta.sma(vp, vwap_len) / ta.sma(volume, vwap_len)
dev = (close - vwap_val) / vwap_val * 100
atr_val = ta.atr(atr_len)

// ───── Signals ─────
long_cond  = ta.crossunder(dev, -dev_thr)
short_cond = ta.crossover(dev, dev_thr)

// ───── Entry / Exit ─────
if long_cond
    strategy.entry("LONG", strategy.long)
    strategy.exit("LONG EXIT", "LONG",
      stop=close - sl_atr * atr_val,
      limit=close + tp_atr * atr_val)

if short_cond
    strategy.entry("SHORT", strategy.short)
    strategy.exit("SHORT EXIT", "SHORT",
      stop=close + sl_atr * atr_val,
      limit=close - tp_atr * atr_val)

// ───── VWAP Plot ─────
plot(vwap_val, "VWAP", color=color.blue, linewidth=2)
hline(0, "Center", color=color.gray, linestyle=hline.style_dotted)

// ───── Deviation Bands ─────
if show_bands
    upper_band = vwap_val * (1 + dev_thr / 100)
    lower_band = vwap_val * (1 - dev_thr / 100)
    plot(upper_band, "Upper", color=color.red, style=plot.style_circles, linewidth=1)
    plot(lower_band, "Lower", color=color.green, style=plot.style_circles, linewidth=1)

// ───── Entry Signals on Chart ─────
plotshape(long_cond,  "LONG",  shape.triangleup,   location.belowbar, color.green,  size=size.small)
plotshape(short_cond, "SHORT", shape.triangledown, location.abovebar, color.red,    size=size.small)

// ───── Performance Table ─────
var table perf = table.new(position.top_right, 2, 7,
  bgcolor=color.new(color.black, 80),
  border_width=1, border_color=color.gray)
if barstate.islastconfirmedtick
    total_trades = strategy.wintrades + strategy.losstrades
    win_rate = total_trades > 0 ? strategy.wintrades / total_trades * 100 : 0
    profit_factor = strategy.grossloss != 0 ? strategy.grossprofit / math.abs(strategy.grossloss) : 0

    var float peak = na
    var float dd = 0.0
    peak := na(peak) ? strategy.equity : math.max(peak, strategy.equity)
    dd := peak > 0 ? (strategy.equity - peak) / peak * 100 : dd

    // Simplified Sharpe (daily returns approximation)
    avg_return = total_trades > 0 ? strategy.netprofit / total_trades : 0
    sharpe = avg_return != 0 and atr_val != 0 ? (avg_return / (atr_val / close * 100)) * math.sqrt(365) : 0

    table.cell(perf, 0, 0, "VWAP BREAKOUT", text_color=color.yellow, text_size=size.small)
    table.cell(perf, 0, 1, "Net Profit", text_color=color.gray, text_size=size.tiny)
    table.cell(perf, 1, 1, "$" + str.tostring(strategy.netprofit, "#,##0.00"), text_color=strategy.netprofit > 0 ? color.lime : color.red, text_size=size.tiny)
    table.cell(perf, 0, 2, "Win Rate", text_color=color.gray, text_size=size.tiny)
    table.cell(perf, 1, 2, str.tostring(win_rate, "#.##") + "%", text_color=color.lime, text_size=size.tiny)
    table.cell(perf, 0, 3, "Profit Factor", text_color=color.gray, text_size=size.tiny)
    table.cell(perf, 1, 3, str.tostring(profit_factor, "#.##"), text_color=profit_factor > 1.5 ? color.lime : color.orange, text_size=size.tiny)
    table.cell(perf, 0, 4, "Max DD", text_color=color.gray, text_size=size.tiny)
    table.cell(perf, 1, 4, str.tostring(dd, "#.##") + "%", text_color=dd > -10 ? color.lime : color.red, text_size=size.tiny)
    table.cell(perf, 0, 5, "Total Trades", text_color=color.gray, text_size=size.tiny)
    table.cell(perf, 1, 5, str.tostring(total_trades), text_color=color.white, text_size=size.tiny)
    table.cell(perf, 0, 6, "Sharpe (est)", text_color=color.gray, text_size=size.tiny)
    table.cell(perf, 1, 6, str.tostring(sharpe, "#.##"), text_color=color.lime, text_size=size.tiny)

// ───── Alert ─────
alertcondition(long_cond,  "VWAP LONG",  "VWAP Breakout LONG signal")
alertcondition(short_cond, "VWAP SHORT", "VWAP Breakout SHORT signal")

// ───── Equity Curve ─────
if show_equity
    plot(strategy.equity, "Equity", color=color.blue, linewidth=2, display=display.pane)

// ───── Footer ─────
// Live signals (free): https://t.me/vwapsignals
// Track record: https://github.com/franotamendi7-commits/structural-expansion-flow
