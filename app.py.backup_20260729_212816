# ============================================================
# BINANCE TESTNET HELPERS
# ============================================================
def _load_secrets():
    """Load API keys from secrets.toml."""
    secrets_path = APP_DIR / ".streamlit" / "secrets.toml"
    try:
        import toml
        secrets = toml.load(secrets_path)
        return (
            secrets.get("BINANCE_API_KEY", ""),
            secrets.get("BINANCE_SECRET_KEY", ""),
        )
    except Exception:
        return "", ""


def _sign_params(params: dict, secret: str) -> dict:
    """Sign Binance API request."""
    query = urllib.parse.urlencode(params)
    sig = hmac.new(secret.encode(), query.encode(), hashlib.sha256).hexdigest()
    params["signature"] = sig
    return params


def _testnet_request(method: str, endpoint: str, params: dict = None) -> Optional[dict]:
    """Make a signed request to Binance Futures Testnet."""
    api_key, api_secret = _load_secrets()
    if not api_key or not api_secret:
        return None
    if params is None:
        params = {}
    params["timestamp"] = int(time.time() * 1000)
    signed = _sign_params(params, api_secret)
    headers = {"X-MBX-APIKEY": api_key}
    base = "https://testnet.binancefuture.com"
    try:
        if method == "GET":
            r = requests.get(f"{base}{endpoint}", params=signed, headers=headers, timeout=10)
        else:
            r = requests.post(f"{base}{endpoint}", params=signed, headers=headers, timeout=10)
        if r.status_code == 200:
            return r.json()
    except Exception:
        pass
    return None


def get_testnet_balance() -> float:
    """Get USDT balance from testnet."""
    data = _testnet_request("GET", "/fapi/v3/balance")
    if data:
        for b in data:
            if b.get("asset") == "USDT":
                return float(b.get("balance", 0))
    return 0.0


def get_testnet_positions() -> List[Dict]:
    """Get open positions from testnet."""
    data = _testnet_request("GET", "/fapi/v3/positionRisk")
    if data:
        return [p for p in data if float(p.get("positionAmt", 0)) != 0]
    return []


def get_live_price(symbol: str) -> Optional[float]:
    """Get latest price from mainnet (more reliable for data)."""
    try:
        r = requests.get("https://fapi.binance.com/fapi/v1/ticker/price",
                         params={"symbol": symbol}, timeout=5)
        if r.status_code == 200:
            return float(r.json()["price"])
    except Exception:
        pass
    return None


# ============================================================
# STATE FILE READERS
# ============================================================
def load_json(path: Path, default=None):
    """Load a JSON file safely."""
    try:
        if path.exists():
            with open(path) as f:
                return json.load(f)
    except Exception:
        pass
    return default if default is not None else {}


def get_drawdown_state() -> Dict:
    """Read drawdown manager state."""
    return load_json(APP_DIR / "drawdown_state.json", {
        "peak_equity": 0, "current_equity": 0,
        "current_dd_pct": 0, "is_stopped": False,
    })


def get_parameter_state() -> Dict:
    """Read parameter adapter state."""
    return load_json(APP_DIR / "parameter_state.json", {
        "params": {}, "is_paused": False, "total_trades_recorded": 0,
    })


def get_signal_log() -> List[Dict]:
    """Read signal log (last 20 entries)."""
    data = load_json(APP_DIR / "signal_log.json", [])
    if isinstance(data, list):
        return data[-20:]
    return []


def get_trade_history() -> List[Dict]:
    """Read trade history (last 20 entries)."""
    data = load_json(APP_DIR / "trade_history.json", [])
    if isinstance(data, list):
        return data[-20:]
    return []


def get_equity_history() -> List[Dict]:
    """Read equity history."""
    data = load_json(APP_DIR / "equity_history.json", [])
    if isinstance(data, list):
        return data
    return []


def get_bot_status() -> str:
    """Check if bot process is running."""
    import subprocess
    try:
        result = subprocess.run(["pgrep", "-f", "multi_bot_v2"],
                              capture_output=True, text=True, timeout=5)
        if result.returncode == 0:
            pid = result.stdout.strip().split("\n")[0]
            return f"RUNNING (PID {pid})"
    except Exception:
        pass
    return "STOPPED"


def get_last_log_lines(n: int = 15) -> List[str]:
    """Read last N lines from bot log."""
    log_path = APP_DIR / "logs" / "paper_trading.log"
    try:
        if log_path.exists():
            with open(log_path) as f:
                lines = f.readlines()
                return [l.rstrip() for l in lines[-n:]]
    except Exception:
        pass
    return []


