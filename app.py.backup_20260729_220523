# HELPER: Format timestamp
# ============================================================
def fmt_ts(ts_val) -> str:
    """Format a timestamp value to short string."""
    if isinstance(ts_val, str) and "T" in ts_val:
        try:
            dt = datetime.fromisoformat(ts_val.replace("Z", "+00:00"))
            return dt.strftime("%m/%d %H:%M")
        except Exception:
            return ts_val[:16].replace("T", " ")
    return str(ts_val)[:16] if ts_val else "?"


def fmt_ts_time(ts_val) -> str:
    """Extract just the time portion."""
    if isinstance(ts_val, str) and "T" in ts_val:
        try:
            dt = datetime.fromisoformat(ts_val.replace("Z", "+00:00"))
            return dt.strftime("%H:%M")
        except Exception:
            return ts_val[-8:]
    return "?"


