    # ============================================================
    # 4. POSITIONS + SIGNALS — SIDE BY SIDE
    # ============================================================
    col_pos, col_sig = st.columns(2)

    with col_pos:
        st.html('''
        <div class="hud-section">
            <div class="hud-section-bar"></div>
            <div class="hud-section-text">OPEN POSITIONS</div>
            <div class="hud-section-line"></div>
        </div>
        ''')

        if positions:
            rows = ""
            for p in positions:
                symbol = p.get("symbol", "?")
                amt = float(p.get("positionAmt", 0))
                entry = float(p.get("entryPrice", 0))
                mark = float(p.get("markPrice", 0))
                pnl = float(p.get("unRealizedProfit", 0))
                lev = p.get("leverage", "?")
                side = "LONG" if amt > 0 else "SHORT"
                badge = "neon-badge-long" if amt > 0 else "neon-badge-short"
                pnl_cls = "positive" if pnl >= 0 else "negative"
                notional = abs(amt) * entry
                pnl_pct = (pnl / notional * 100) if notional > 0 else 0

                rows += f'''
                <tr>
                    <td style="color:var(--neon-cyan);font-weight:700;">{PAIR_LABELS.get(symbol, symbol)}</td>
                    <td><span class="neon-badge {badge}">{side}</span></td>
                    <td>{abs(amt):.6f}</td>
                    <td>${entry:,.2f}</td>
                    <td>${mark:,.2f}</td>
                    <td class="{pnl_cls}" style="font-weight:700;">
                        {'+' if pnl >= 0 else ''}${pnl:.2f}
