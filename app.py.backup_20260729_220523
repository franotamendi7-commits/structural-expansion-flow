                dtype = s.get("type", "?")
                direction = s.get("dir", 0)
                entry = s.get("entry", 0)
                score = s.get("score", None)

                is_latest = (idx == 0)

                if direction == 1:
                    dir_badge = '<span class="neon-badge neon-badge-long">LONG</span>'
                    dot_cls = "signal-dot signal-dot-long"
                elif direction == -1:
                    dir_badge = '<span class="neon-badge neon-badge-short">SHORT</span>'
                    dot_cls = "signal-dot signal-dot-short"
