        # -3% warning line
        fig.add_hline(y=-3, row=2, col=1,
                      line_color="rgba(245, 158, 11, 0.15)", line_width=1,
                      line_dash="dot")

        fig.update_layout(
            height=420,
            showlegend=False,
            **PLOTLY_LAYOUT
        )
        fig.update_xaxes(showgrid=False, row=1, col=1)
        fig.update_xaxes(showgrid=False, row=2, col=1)
        fig.update_yaxes(gridcolor="rgba(0, 212, 255, 0.03)", row=1, col=1)
        fig.update_yaxes(gridcolor="rgba(0, 212, 255, 0.03)", row=2, col=1)

        st.plotly_chart(fig, width="stretch", use_container_width=True)
    else:
        st.html('''
        <div class="glass-panel">
            <div class="empty-holo">
                <div class="empty-holo-icon">📊</div>
                <div class="empty-holo-text">Waiting for equity data to accumulate...</div>
            </div>
