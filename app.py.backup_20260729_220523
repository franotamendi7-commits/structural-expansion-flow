        fig.add_trace(
            go.Scatter(
                x=df["time"], y=df["equity"],
                mode="lines",
                line=dict(color="#00d4ff", width=2, shape="spline"),
                fill="tozeroy",
                fillcolor="rgba(0, 212, 255, 0.06)",
                name="Equity",
                hovertemplate="<b>Equity</b><br>$%{y:,.2f}<extra></extra>"
            ),
            row=1, col=1
        )

        # Peak line (dotted)
        fig.add_trace(
            go.Scatter(
                x=df["time"], y=df["peak"],
