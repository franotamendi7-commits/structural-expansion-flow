        st.html(f'''
        <div class="glass-panel" style="padding:0;overflow:hidden;">
            <table class="holo-table">
                <thead><tr>
                    <th>TIME</th><th>BOT</th><th>SIDE</th>
                    <th>ENTRY</th><th>EXIT</th><th>PNL</th><th>REASON</th><th>HOLD</th>
                </tr></thead>
                <tbody>{rows}</tbody>
            </table>
        </div>
        ''')

    # ============================================================
    # 7. BOT LOG — TERMINAL STYLE
    # ============================================================
    st.html('''
    <div class="hud-section">
        <div class="hud-section-bar"></div>
        <div class="hud-section-text">BOT LOG</div>
        <div class="hud-section-line"></div>
    </div>
    ''')

    log_lines = get_last_log_lines(20)
    if log_lines:
        log_html = '''
        <div class="terminal-log">
            <div class="terminal-header">
                <div class="terminal-dot terminal-dot-red"></div>
                <div class="terminal-dot terminal-dot-yellow"></div>
                <div class="terminal-dot terminal-dot-green"></div>
                <div class="terminal-title">system — paper_trading.log</div>
            </div>
            <div class="terminal-body">
        '''

        for line in reversed(log_lines):
            # Syntax highlighting
            if "ERROR" in line or "FAIL" in line:
                msg_cls = "log-msg-error"
            elif "WARNING" in line or "WARN" in line:
                msg_cls = "log-msg-warning"
            elif "SUCCESS" in line or "PROFIT" in line or "WIN" in line:
                msg_cls = "log-msg-success"
            elif "Signal" in line or "SIGNAL" in line or "LONG" in line or "SHORT" in line:
                msg_cls = "log-msg-signal"
            elif "Order" in line or "ORDER" in line or "executed" in line:
                msg_cls = "log-msg-order"
            elif "INFO" in line or "Tick" in line:
                msg_cls = "log-msg-info"
            else:
                msg_cls = "log-msg"

            # Extract timestamp if present
            ts_str = ""
            msg_str = line
            if line.startswith("[") and "]" in line:
                bracket_end = line.index("]")
                ts_str = line[1:bracket_end]
                msg_str = line[bracket_end + 2:]

            # Truncate
            if len(msg_str) > 130:
                msg_str = msg_str[:127] + "..."

            if ts_str:
                log_html += f'<div class="log-entry"><span class="log-ts">[{ts_str}]</span><span class="{msg_cls}">{msg_str}</span></div>'
            else:
                log_html += f'<div class="log-entry"><span class="{msg_cls}">{msg_str}</span></div>'

        log_html += '''
            </div>
        </div>
        '''
        st.html(log_html)
    else:
        st.html('''
        <div class="glass-panel">
            <div class="empty-holo">
                <div class="empty-holo-icon">📋</div>
                <div class="empty-holo-text">No logs available</div>
            </div>
        </div>
        ''')

