    # ============================================================
    params = param_state.get("params", {})
    if params:
        st.html('''
        <div class="hud-section">
            <div class="hud-section-bar"></div>
            <div class="hud-section-text">ACTIVE PARAMETERS</div>
            <div class="hud-section-line"></div>
        </div>
        ''')

        param_html = '<div class="glass-panel" style="padding:0;overflow:hidden;">'
        for i, (k, v) in enumerate(params.items()):
            border = "" if i == len(params) - 1 else "border-bottom: 1px solid rgba(0,212,255,0.04);"
            param_html += f'''
            <div style="display:flex;justify-content:space-between;align-items:center;
                        padding:12px 20px;{border}transition:background 0.2s ease;"
                 onmouseover="this.style.background='rgba(0,212,255,0.02)'"
                 onmouseout="this.style.background='transparent'">
                <span style="color:var(--text-secondary);font-size:0.8rem;font-family:Inter,sans-serif;">
                    {k.replace('_', ' ').title()}
                </span>
                <span style="color:var(--neon-cyan);font-family:JetBrains Mono,monospace;font-weight:600;font-size:0.82rem;">
                    {v}
                </span>
            </div>'''

        param_html += '</div>'
        st.html(param_html)

    # ============================================================
    # 9. FOOTER
    # ============================================================
    st.html(f'''
    <div class="holo-footer">
        <div class="holo-footer-text">
            STRUCTURAL EXPANSION FLOW · INSTITUTIONAL ENGINE V2 · VOID THEME 2030 ·
            REFRESH {now.strftime('%H:%M:%S UTC')} · MODE TESTNET ·
            {'● RUNNING' if is_running else '○ STOPPED'}
        </div>
    </div>
    ''')


