                if dtype_lower == "entry":
                    type_badge = '<span class="neon-badge neon-badge-long" style="font-size:0.5rem;">ENTRY</span>'
                elif dtype_lower == "exit":
                    type_badge = '<span class="neon-badge neon-badge-short" style="font-size:0.5rem;">EXIT</span>'
                else:
                    type_badge = f'<span class="neon-badge neon-badge-wait" style="font-size:0.5rem;">{dtype.upper()}</span>'

                score_html = ""
                if score is not None:
                    sv = float(score)
                    sc = "var(--profit)" if sv >= 70 else "var(--neon-amber)" if sv >= 50 else "var(--loss)"
                    score_html = f'<span style="color:{sc};font-size:0.68rem;font-family:JetBrains Mono;font-weight:600;">{sv:.0f}</span>'

                timeline_html += f'''
                <div class="signal-item" style="animation-delay:{idx * 0.05}s;">
                    <div class="{dot_cls}"></div>
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:3px;">
                        <div style="display:flex;align-items:center;gap:8px;">
                            <span style="color:var(--neon-cyan);font-weight:700;font-size:0.82rem;font-family:JetBrains Mono;">{PAIR_LABELS.get(sym, sym)}</span>
                            {dir_badge}
                            {type_badge}
                        </div>
                        <div style="text-align:right;">
                            <div style="color:var(--text-dim);font-size:0.65rem;font-family:JetBrains Mono;">{ts_date} {ts_short}</div>
                        </div>
                    </div>
                    <div style="display:flex;justify-content:space-between;align-items:center;">
                        <span style="color:var(--text-secondary);font-size:0.72rem;font-family:JetBrains Mono;">${entry:,.2f}</span>
                        {score_html}
                    </div>
                </div>'''

            timeline_html += '</div>'
            st.html(f'''
            <div class="glass-panel" style="max-height:420px;overflow-y:auto;">
                {timeline_html}
            </div>
            ''')
        else:
            st.html('''
            <div class="glass-panel">
                <div class="empty-holo">
                    <div class="empty-holo-icon">📡</div>
                    <div class="empty-holo-text">No signals recorded yet</div>
                </div>
            </div>
            ''')

    # ============================================================
    # 5. PERFORMANCE MATRIX — HUD DISPLAY
    # ============================================================
    perf = calculate_performance_metrics(trade_history)

    # Determine quality colors
    sharpe_cls = "positive" if perf["sharpe"] > 1 else "negative" if perf["sharpe"] < 0 else "neutral"
    sortino_cls = "positive" if perf["sortino"] > 1.5 else "neutral"
    pf_cls = "positive" if perf["profit_factor"] > 1.3 else "negative" if perf["profit_factor"] < 1 else "neutral"
    wr_cls = "positive" if perf["win_rate"] > 50 else "neutral"
    exp_cls = "positive" if perf["expectancy"] > 0 else "negative"

    st.html('''
    <div class="hud-section">
        <div class="hud-section-bar"></div>
        <div class="hud-section-text">PERFORMANCE MATRIX</div>
        <div class="hud-section-line"></div>
    </div>
    ''')

    st.html(f'''
    <div class="hud-matrix">
        <div class="hud-cell">
            <div class="hud-cell-label">SHARPE</div>
            <div class="hud-cell-value {sharpe_cls}">{perf["sharpe"]:.2f}</div>
            <div class="hud-cell-sub">target &gt; 1.0</div>
        </div>
        <div class="hud-cell">
            <div class="hud-cell-label">SORTINO</div>
            <div class="hud-cell-value {sortino_cls}">{perf["sortino"]:.2f}</div>
            <div class="hud-cell-sub">target &gt; 1.5</div>
        </div>
        <div class="hud-cell">
            <div class="hud-cell-label">PROFIT FACTOR</div>
            <div class="hud-cell-value {pf_cls}">{perf["profit_factor"]:.2f}</div>
            <div class="hud-cell-sub">target &gt; 1.3</div>
        </div>
        <div class="hud-cell">
            <div class="hud-cell-label">WIN RATE</div>
            <div class="hud-cell-value {wr_cls}">{perf["win_rate"]:.1f}%</div>
            <div class="hud-cell-sub">target &gt; 45%</div>
        </div>
        <div class="hud-cell">
            <div class="hud-cell-label">EXPECTANCY</div>
            <div class="hud-cell-value {exp_cls}">{'+' if perf["expectancy"] >= 0 else ''}${perf["expectancy"]:.2f}</div>
            <div class="hud-cell-sub">per trade</div>
        </div>
    </div>
    <div class="hud-matrix-bottom">
        <div class="hud-cell">
            <div class="hud-cell-label">TOTAL TRADES</div>
            <div class="hud-cell-value cyan">{perf["total_trades"]}</div>
        </div>
        <div class="hud-cell">
            <div class="hud-cell-label">AVG TRADE</div>
            <div class="hud-cell-value {'positive' if perf['total_pnl'] >= 0 else 'negative'}">
                {'+' if perf['total_pnl'] >= 0 else ''}${perf["total_pnl"] / max(perf["total_trades"], 1):.2f}
            </div>
        </div>
        <div class="hud-cell">
            <div class="hud-cell-label">BEST TRADE</div>
            <div class="hud-cell-value positive">+${perf["best_trade"]:.2f}</div>
        </div>
        <div class="hud-cell">
            <div class="hud-cell-label">WORST TRADE</div>
            <div class="hud-cell-value negative">${perf["worst_trade"]:.2f}</div>
        </div>
    </div>
    ''')

    # ============================================================
    # 6. TRADE HISTORY TABLE
    # ============================================================
    if trade_history:
        st.html('''
        <div class="hud-section">
            <div class="hud-section-bar"></div>
            <div class="hud-section-text">RECENT TRADES</div>
            <div class="hud-section-line"></div>
        </div>
        ''')

        rows = ""
        for t in reversed(trade_history[-10:]):
            exit_time = fmt_ts(t.get("exit_time", "?"))
            sym = t.get("symbol", "?")
            bot = t.get("bot_name", "?")
            d = t.get("dir", 0)
            entry = t.get("entry", 0)
            exit_p = t.get("exit", 0)
            net = t.get("net", 0)
            reason = t.get("exit_reason", "?")
            hold = t.get("hold_minutes", 0)

            pnl_cls = "positive" if net >= 0 else "negative"
            side = "LONG" if d == 1 else "SHORT"
            badge = "neon-badge-long" if d == 1 else "neon-badge-short"

            if hold < 60:
                hold_str = f"{hold:.0f}m"
            else:
                hold_str = f"{hold / 60:.1f}h"

            rows += f'''
            <tr>
                <td style="color:var(--text-dim);font-size:0.72rem;">{exit_time}</td>
                <td style="color:var(--neon-cyan);font-weight:600;">{bot}</td>
                <td><span class="neon-badge {badge}">{side}</span></td>
                <td>${entry:,.2f}</td>
                <td>${exit_p:,.2f}</td>
                <td class="{pnl_cls}" style="font-weight:700;">
                    {'+' if net >= 0 else ''}${net:.2f}
                </td>
                <td><span class="neon-badge neon-badge-wait">{reason.upper()}</span></td>
                <td style="color:var(--text-secondary);">{hold_str}</td>
