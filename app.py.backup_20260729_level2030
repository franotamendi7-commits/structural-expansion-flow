def calculate_performance_metrics(trades: List[Dict]) -> Dict:
    """Calculate comprehensive performance metrics from trade history."""
    if not trades:
        return {
            "sharpe": 0, "sortino": 0, "profit_factor": 0,
            "win_rate": 0, "total_trades": 0, "avg_trade_duration": 0,
            "best_trade": 0, "worst_trade": 0, "total_pnl": 0,
            "avg_win": 0, "avg_loss": 0, "expectancy": 0
        }

    pnls = [t.get("net", 0) for t in trades]
    wins = [p for p in pnls if p > 0]
    losses = [p for p in pnls if p < 0]

    # Basic metrics
    total_trades = len(trades)
    win_rate = (len(wins) / total_trades * 100) if total_trades > 0 else 0
    total_pnl = sum(pnls)
    
    # Profit factor
    gross_profit = sum(wins) if wins else 0
    gross_loss = abs(sum(losses)) if losses else 0
    profit_factor = (gross_profit / gross_loss) if gross_loss > 0 else float('inf')
    
    # Average trade duration
    durations = [t.get("hold_minutes", 0) for t in trades]
    avg_duration = np.mean(durations) if durations else 0
    
    # Best/worst trade
    best_trade = max(pnls) if pnls else 0
    worst_trade = min(pnls) if pnls else 0
    
    # Average win/loss
    avg_win = np.mean(wins) if wins else 0
    avg_loss = np.mean(losses) if losses else 0
    
    # Expectancy
    expectancy = (win_rate/100 * avg_win) + ((1 - win_rate/100) * avg_loss)
    
    # Sharpe Ratio (simplified - daily returns approximation)
    if len(pnls) > 1:
        returns = np.array(pnls)
        sharpe = (np.mean(returns) / np.std(returns)) * np.sqrt(252) if np.std(returns) > 0 else 0
        
        # Sortino Ratio (downside deviation)
        downside_returns = returns[returns < 0]
        downside_std = np.std(downside_returns) if len(downside_returns) > 0 else 1
        sortino = (np.mean(returns) / downside_std) * np.sqrt(252) if downside_std > 0 else 0
    else:
        sharpe = 0
        sortino = 0

    return {
        "sharpe": round(sharpe, 2),
        "sortino": round(sortino, 2),
        "profit_factor": round(profit_factor, 2),
        "win_rate": round(win_rate, 1),
        "total_trades": total_trades,
        "avg_trade_duration": round(avg_duration, 0),
        "best_trade": round(best_trade, 4),
        "worst_trade": round(worst_trade, 4),
        "total_pnl": round(total_pnl, 4),
        "avg_win": round(avg_win, 4),
        "avg_loss": round(avg_loss, 4),
        "expectancy": round(expectancy, 4)
    }


