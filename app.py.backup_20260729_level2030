# ============================================================
# STREAMLIT APP
# ============================================================
def main():
    st.set_page_config(
        page_title=PAGE_TITLE,
        page_icon=PAGE_ICON,
        layout="wide",
        initial_sidebar_state="collapsed",
    )

    # Inject CSS
    if hasattr(st, "html"):
        st.html(CUSTOM_CSS)

    # Auto-refresh
    try:
        from streamlit_autorefresh import st_autorefresh
        st_autorefresh(interval=REFRESH_INTERVAL_SEC * 1000, key="refresh")
    except Exception:
        pass

    # ============================================================
    # HEADER
    # ============================================================
    now = datetime.now(timezone.utc)
    bot_status = get_bot_status()
    is_running = "RUNNING" in bot_status
    status_color = "green" if is_running else "red"
    status_class = "live-dot-green" if is_running else "live-dot-red"
    status_badge = "badge-ok" if is_running else "badge-stop"

    # Get balance for header
    balance = get_testnet_balance()
    dd_state = get_drawdown_state()
    peak_equity = dd_state.get("peak_equity", 0)

    st.html(f"""
    <div class="header-container">
        <div>
            <div class="header-logo">
                <span class="neon-text">⚡</span> STRUCTURAL EXPANSION FLOW
            </div>
            <div class="header-subtitle">
                Institutional Engine V2 · BTC · ETH · SOL · XRP · BNB
            </div>
        </div>
        <div class="header-right">
            <div class="header-stat">
                <div class="header-stat-label">STATUS</div>
                <div class="header-stat-value">
                    <span class="badge {status_badge}">
                        <span class="live-dot {status_class}"></span>
                        {bot_status}
                    </span>
                </div>
            </div>
            <div class="header-stat">
                <div class="header-stat-label">UTC TIME</div>
                <div class="header-stat-value">{now.strftime('%H:%M:%S')}</div>
            </div>
            <div class="header-stat">
                <div class="header-stat-label">DATE</div>
                <div class="header-stat-value">{now.strftime('%Y-%m-%d')}</div>
            </div>
        </div>
    </div>
    """)

    # ============================================================
    # TOP METRIC CARDS
    # ============================================================
    dd_pct = dd_state.get("current_dd_pct", 0)
    param_state = get_parameter_state()
    is_paused = param_state.get("is_paused", False)
    total_trades = param_state.get("total_trades_recorded", 0)

    # Determine risk mode
    if is_paused:
        risk_mode = "PAUSED"
        risk_badge = "badge-stop"
        risk_class = "risk-paused"
    elif dd_pct < -7:
        risk_mode = "REDUCED"
        risk_badge = "badge-warn"
        risk_class = "risk-reduced"
    elif dd_pct < -3:
        risk_mode = "CAUTION"
        risk_badge = "badge-warn"
        risk_class = "risk-reduced"
    else:
        risk_mode = "NORMAL"
        risk_badge = "badge-ok"
        risk_class = "risk-normal"

    # Get positions for unrealized PnL
    positions = get_testnet_positions()
    unrealized_pnl = sum(float(p.get("unRealizedProfit", 0)) for p in positions)
    n_positions = len(positions)

    # Calculate drawdown progress
    dd_abs = abs(dd_pct)
    dd_progress = min(dd_abs / 10 * 100, 100)  # 10% = full bar
    if dd_abs < 3:
        dd_bar_class = "progress-green"
    elif dd_abs < 7:
        dd_bar_class = "progress-orange"
    else:
        dd_bar_class = "progress-red"

    # Calculate balance change from trade history
    trade_history = get_trade_history()
    last_trade_pnl = trade_history[-1].get("net", 0) if trade_history else 0

    cards_html = f"""
    <div class="grid-4">
        <!-- Equity Card -->
        <div class="metric-card">
            <div class="card-label">EQUITY</div>
            <div class="card-value">${balance:,.2f}</div>
            <div class="card-sub">
                <span class="{'positive' if last_trade_pnl >= 0 else 'negative'}">
                    {'▲' if last_trade_pnl >= 0 else '▼'} ${abs(last_trade_pnl):.4f}
                </span>
                <span class="neutral"> last trade</span>
            </div>
        </div>
        
        <!-- Unrealized PnL Card -->
        <div class="metric-card">
            <div class="card-label">UNREALIZED PNL</div>
            <div class="card-value {'positive' if unrealized_pnl >= 0 else 'negative' if unrealized_pnl < 0 else ''}">
                {'+' if unrealized_pnl >= 0 else ''}${unrealized_pnl:.4f}
            </div>
            <div class="card-sub">
                <span class="cyan">{n_positions}</span>
                <span class="neutral"> position{'s' if n_positions != 1 else ''} open</span>
            </div>
        </div>
        
        <!-- Drawdown Card -->
        <div class="metric-card">
            <div class="card-label">DRAWDOWN</div>
            <div class="card-value {'positive' if dd_pct >= 0 else 'negative'}">
                {dd_pct:+.2f}%
            </div>
            <div class="card-sub">
                <span class="neutral">peak: </span>
                <span class="gold">${peak_equity:,.2f}</span>
            </div>
            <div class="progress-bar">
                <div class="progress-fill {dd_bar_class}" style="width: {dd_progress}%"></div>
            </div>
        </div>
        
        <!-- Risk Mode Card -->
        <div class="metric-card">
            <div class="card-label">RISK MODE</div>
            <div class="card-value {risk_class}" style="font-size: 1.4rem;">
                <span class="badge {risk_badge}" style="font-size: 0.8rem; padding: 6px 16px;">
                    {risk_mode}
                </span>
            </div>
            <div class="card-sub">
                <span class="neutral">trades: </span>
                <span class="cyan">{total_trades}</span>
            </div>
        </div>
    </div>
    """
    st.html(cards_html)

    # ============================================================
    # EQUITY CURVE + DRAWDOWN CHART
    # ============================================================
    equity_hist = get_equity_history()
    if len(equity_hist) > 1:
        st.html('<div class="section-header">EQUITY CURVE</div>')
        
        df = pd.DataFrame(equity_hist)
        df["peak"] = df["equity"].cummax()
        df["dd"] = (df["equity"] - df["peak"]) / df["peak"] * 100
        
        # Create subplot with equity and drawdown
        fig = make_subplots(
            rows=2, cols=1,
            shared_xaxes=True,
            vertical_spacing=0.08,
            row_heights=[0.7, 0.3],
            subplot_titles=("Equity", "Drawdown")
        )
        
        # Equity line
        fig.add_trace(
            go.Scatter(
                x=df["time"], y=df["equity"],
                mode="lines",
                line=dict(color="#00d4ff", width=2),
                fill="tozeroy",
                fillcolor="rgba(0, 212, 255, 0.08)",
                name="Equity",
                hovertemplate="Equity: $%{y:,.2f}<extra></extra>"
            ),
            row=1, col=1
        )
        
        # Drawdown line
        fig.add_trace(
            go.Scatter(
                x=df["time"], y=df["dd"],
                mode="lines",
                line=dict(color="#ff4757", width=1.5),
                fill="tozeroy",
                fillcolor="rgba(255, 71, 87, 0.1)",
                name="Drawdown",
                hovertemplate="DD: %{y:.2f}%<extra></extra>"
            ),
            row=2, col=1
        )
        
        # Add zero line for drawdown
        fig.add_hline(y=0, row=2, col=1, line_color="rgba(255,255,255,0.1)", line_width=1)
        
        fig.update_layout(
            height=400,
            showlegend=False,
            **PLOTLY_LAYOUT
        )
        
        fig.update_xaxes(showgrid=False, row=1, col=1)
        fig.update_xaxes(showgrid=False, row=2, col=1)
        fig.update_yaxes(gridcolor="rgba(48, 54, 61, 0.4)", row=1, col=1)
        fig.update_yaxes(gridcolor="rgba(48, 54, 61, 0.4)", row=2, col=1)
        
        st.plotly_chart(fig, width="stretch", use_container_width=True)
    else:
        st.html("""
        <div class="chart-container">
            <div class="empty-state">
                <div class="empty-state-icon">📊</div>
                <div class="empty-state-text">Waiting for equity data to accumulate...</div>
            </div>
        </div>
        """)

    # ============================================================
    # POSITIONS + SIGNALS (Side by side)
    # ============================================================
    col_pos, col_sig = st.columns(2)

    with col_pos:
        st.html('<div class="section-header">OPEN POSITIONS</div>')
        
        if positions:
            rows = ""
            for p in positions:
                symbol = p.get("symbol", "?")
                amt = float(p.get("positionAmt", 0))
                entry = float(p.get("entryPrice", 0))
                mark = float(p.get("markPrice", 0))
                pnl = float(p.get("unRealizedProfit", 0))
                lev = p.get("leverage", "?")
                side = "LONG" if amt > 0 else "SHORT"
                badge = "badge-long" if amt > 0 else "badge-short"
                pnl_class = "positive" if pnl >= 0 else "negative"
                
                # Calculate PnL percentage
                notional = abs(amt) * entry
                pnl_pct = (pnl / notional * 100) if notional > 0 else 0
                
                rows += f"""
                <tr>
                    <td style="color:var(--cyan);font-weight:600;">{PAIR_LABELS.get(symbol, symbol)}</td>
                    <td><span class="badge {badge}">{side}</span></td>
                    <td>{abs(amt):.6f}</td>
                    <td>${entry:,.2f}</td>
                    <td>${mark:,.2f}</td>
                    <td class="{pnl_class}" style="font-weight:600;">
                        {'+' if pnl >= 0 else ''}${pnl:.4f}
                        <span style="font-size:0.7rem; opacity:0.7;">({pnl_pct:+.2f}%)</span>
                    </td>
                    <td><span class="badge badge-cyan">{lev}×</span></td>
                </tr>
                """
            
            st.html(f"""
            <table class="monitor">
                <thead><tr>
                    <th>PAIR</th><th>SIDE</th><th>SIZE</th>
                    <th>ENTRY</th><th>MARK</th><th>PNL</th><th>LEV</th>
                </tr></thead>
                <tbody>{rows}</tbody>
            </table>
            """)
        else:
            st.html("""
            <div class="metric-card">
                <div class="empty-state">
                    <div class="empty-state-icon">🎯</div>
                    <div class="empty-state-text">No open positions — waiting for signal</div>
                </div>
            </div>
            """)

    with col_sig:
        st.html('<div class="section-header">RECENT SIGNALS</div>')
        
        signals = get_signal_log()
        if signals:
            timeline_html = '<div class="timeline">'
            
            for s in reversed(signals[-10:]):
                ts = s.get("ts", "?")
                if isinstance(ts, str) and "T" in ts:
                    ts = ts[:19].replace("T", " ")
                    # Extract time only for compact display
                    try:
                        dt = datetime.fromisoformat(ts.replace(" ", "T") + "+00:00")
                        ts_short = dt.strftime("%H:%M")
                        ts_date = dt.strftime("%m/%d")
                    except:
                        ts_short = ts[-8:]
                        ts_date = ""
                
                sym = s.get("symbol", "?")
                dtype = s.get("type", "?")
                direction = s.get("dir", 0)
                entry = s.get("entry", 0)
                score = s.get("score", None)
                
                # Direction badge
                if direction == 1:
                    dir_badge = '<span class="badge badge-long">LONG</span>'
                    dot_class = "timeline-dot-green"
                elif direction == -1:
                    dir_badge = '<span class="badge badge-short">SHORT</span>'
                    dot_class = "timeline-dot-red"
                else:
                    dir_badge = '<span class="badge badge-wait">—</span>'
                    dot_class = "timeline-dot-cyan"
                
                # Type badge
                dtype_lower = dtype.lower() if dtype else ""
                if dtype_lower == "entry":
                    type_badge = '<span class="badge badge-long">ENTRY</span>'
                elif dtype_lower == "exit":
                    type_badge = '<span class="badge badge-short">EXIT</span>'
                else:
                    type_badge = f'<span class="badge badge-wait">{dtype.upper()}</span>'
                
                # Score display
                score_html = ""
                if score is not None:
                    score_val = float(score)
                    score_color = "var(--green)" if score_val >= 70 else "var(--orange)" if score_val >= 50 else "var(--red)"
                    score_html = f'<span style="color:{score_color}; font-size:0.75rem;">Score: {score_val:.0f}</span>'
                
                timeline_html += f"""
                <div class="timeline-item">
                    <div class="timeline-dot {dot_class}"></div>
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:4px;">
                        <div>
                            <span style="color:var(--cyan); font-weight:600;">{PAIR_LABELS.get(sym, sym)}</span>
                            {dir_badge}
                            {type_badge}
                        </div>
                        <div style="text-align:right;">
                            <div style="color:var(--text-secondary); font-size:0.75rem;">{ts_date} {ts_short}</div>
                        </div>
                    </div>
                    <div style="display:flex; justify-content:space-between; align-items:center;">
                        <span style="color:var(--text-secondary); font-size:0.8rem;">Entry: ${entry:,.2f}</span>
                        {score_html}
                    </div>
                </div>
                """
            
            timeline_html += '</div>'
            st.html(f"""
            <div class="metric-card" style="max-height: 400px; overflow-y: auto;">
                {timeline_html}
            </div>
            """)
        else:
            st.html("""
            <div class="metric-card">
                <div class="empty-state">
                    <div class="empty-state-icon">📡</div>
                    <div class="empty-state-text">No signals recorded yet</div>
                </div>
            </div>
            """)

    # ============================================================
    # PERFORMANCE METRICS
    # ============================================================
    st.html('<div class="section-header">PERFORMANCE METRICS</div>')
    
    perf = calculate_performance_metrics(trade_history)
    
    perf_html = f"""
    <div class="grid-4">
        <!-- Sharpe & Sortino -->
        <div class="metric-card">
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
                <div>
                    <div class="card-label">SHARPE RATIO</div>
                    <div class="card-value" style="font-size:1.4rem;">
                        <span class="{'positive' if perf['sharpe'] > 1 else 'neutral'}">{perf['sharpe']:.2f}</span>
                    </div>
                </div>
                <div>
                    <div class="card-label">SORTINO RATIO</div>
                    <div class="card-value" style="font-size:1.4rem;">
                        <span class="{'positive' if perf['sortino'] > 1.5 else 'neutral'}">{perf['sortino']:.2f}</span>
                    </div>
                </div>
            </div>
            <div class="card-sub" style="margin-top:12px;">
                <span class="neutral">Target: Sharpe > 1.0, Sortino > 1.5</span>
            </div>
        </div>
        
        <!-- Profit Factor & Win Rate -->
        <div class="metric-card">
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
                <div>
                    <div class="card-label">PROFIT FACTOR</div>
                    <div class="card-value" style="font-size:1.4rem;">
                        <span class="{'positive' if perf['profit_factor'] > 1.3 else 'negative' if perf['profit_factor'] < 1 else 'neutral'}">{perf['profit_factor']:.2f}</span>
                    </div>
                </div>
                <div>
                    <div class="card-label">WIN RATE</div>
                    <div class="card-value" style="font-size:1.4rem;">
                        <span class="{'positive' if perf['win_rate'] > 50 else 'neutral'}">{perf['win_rate']:.1f}%</span>
                    </div>
                </div>
            </div>
            <div class="card-sub" style="margin-top:12px;">
                <span class="neutral">Target: PF > 1.3, WR > 45%</span>
            </div>
        </div>
        
        <!-- Trade Stats -->
        <div class="metric-card">
            <div class="card-label">TRADE STATISTICS</div>
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-top:12px;">
                <div>
                    <div style="color:var(--text-secondary); font-size:0.7rem;">Total Trades</div>
                    <div style="color:var(--cyan); font-family:'JetBrains Mono'; font-weight:600;">{perf['total_trades']}</div>
                </div>
                <div>
                    <div style="color:var(--text-secondary); font-size:0.7rem;">Avg Duration</div>
                    <div style="color:var(--cyan); font-family:'JetBrains Mono'; font-weight:600;">{perf['avg_trade_duration']:.0f}m</div>
                </div>
                <div>
                    <div style="color:var(--text-secondary); font-size:0.7rem;">Avg Win</div>
                    <div style="color:var(--green); font-family:'JetBrains Mono'; font-weight:600;">+${perf['avg_win']:.4f}</div>
                </div>
                <div>
                    <div style="color:var(--text-secondary); font-size:0.7rem;">Avg Loss</div>
                    <div style="color:var(--red); font-family:'JetBrains Mono'; font-weight:600;">${perf['avg_loss']:.4f}</div>
                </div>
            </div>
        </div>
        
        <!-- Best/Worst + Expectancy -->
        <div class="metric-card">
            <div class="card-label">EXTREMES & EXPECTANCY</div>
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-top:12px;">
                <div>
                    <div style="color:var(--text-secondary); font-size:0.7rem;">Best Trade</div>
                    <div style="color:var(--green); font-family:'JetBrains Mono'; font-weight:600;">+${perf['best_trade']:.4f}</div>
                </div>
                <div>
                    <div style="color:var(--text-secondary); font-size:0.7rem;">Worst Trade</div>
                    <div style="color:var(--red); font-family:'JetBrains Mono'; font-weight:600;">${perf['worst_trade']:.4f}</div>
                </div>
                <div>
                    <div style="color:var(--text-secondary); font-size:0.7rem;">Total PnL</div>
                    <div class="{'positive' if perf['total_pnl'] >= 0 else 'negative'}" style="font-family:'JetBrains Mono'; font-weight:600;">
                        {'+' if perf['total_pnl'] >= 0 else ''}${perf['total_pnl']:.4f}
                    </div>
                </div>
                <div>
                    <div style="color:var(--text-secondary); font-size:0.7rem;">Expectancy</div>
                    <div class="{'positive' if perf['expectancy'] >= 0 else 'negative'}" style="font-family:'JetBrains Mono'; font-weight:600;">
                        {'+' if perf['expectancy'] >= 0 else ''}${perf['expectancy']:.4f}
                    </div>
                </div>
            </div>
        </div>
    </div>
    """
    st.html(perf_html)

    # ============================================================
    # TRADE HISTORY TABLE
    # ============================================================
    if trade_history:
        st.html('<div class="section-header">RECENT TRADES</div>')
        
        rows = ""
        for t in reversed(trade_history[-10:]):
            exit_time = t.get("exit_time", "?")
            if isinstance(exit_time, str) and "T" in exit_time:
                try:
                    dt = datetime.fromisoformat(exit_time.replace(" ", "T") + "+00:00" if "+" not in exit_time else exit_time)
                    exit_time = dt.strftime("%m/%d %H:%M")
                except:
                    exit_time = exit_time[:16].replace("T", " ")
            
            sym = t.get("symbol", "?")
            bot = t.get("bot_name", "?")
            d = t.get("dir", 0)
            entry = t.get("entry", 0)
            exit_p = t.get("exit", 0)
            net = t.get("net", 0)
            reason = t.get("exit_reason", "?")
            hold = t.get("hold_minutes", 0)
            
            pnl_class = "positive" if net >= 0 else "negative"
            side = "LONG" if d == 1 else "SHORT"
            badge = "badge-long" if d == 1 else "badge-short"
            
            # Calculate holding time display
            if hold < 60:
                hold_str = f"{hold:.0f}m"
            else:
                hold_str = f"{hold/60:.1f}h"
            
            rows += f"""
            <tr>
                <td style="color:var(--text-secondary); font-size:0.75rem;">{exit_time}</td>
                <td style="color:var(--cyan); font-weight:600;">{bot}</td>
                <td><span class="badge {badge}">{side}</span></td>
                <td>${entry:,.2f}</td>
                <td>${exit_p:,.2f}</td>
                <td class="{pnl_class}" style="font-weight:600;">
                    {'+' if net >= 0 else ''}${net:.4f}
                </td>
                <td><span class="badge badge-wait">{reason.upper()}</span></td>
                <td style="color:var(--text-secondary);">{hold_str}</td>
            </tr>
            """
        
        st.html(f"""
        <table class="monitor">
            <thead><tr>
                <th>TIME</th><th>BOT</th><th>SIDE</th>
                <th>ENTRY</th><th>EXIT</th><th>PNL</th><th>REASON</th><th>HOLD</th>
            </tr></thead>
            <tbody>{rows}</tbody>
        </table>
        """)

    # ============================================================
    # BOT LOG
    # ============================================================
    st.html('<div class="section-header">BOT LOG</div>')
    
    log_lines = get_last_log_lines(15)
    if log_lines:
        log_html = '<div class="log-container">'
        for line in reversed(log_lines):  # Newest first
            if "WARNING" in line:
                css_class = "log-warning"
            elif "ERROR" in line:
                css_class = "log-error"
            elif "SUCCESS" in line or "PROFIT" in line:
                css_class = "log-success"
            elif "INFO" in line:
                css_class = "log-info"
            else:
                css_class = ""
            
            # Truncate long lines
            if len(line) > 120:
                line = line[:117] + "..."
            
            log_html += f'<div class="log-line {css_class}">{line}</div>'
        
        log_html += '</div>'
        st.html(log_html)
    else:
        st.html("""
        <div class="metric-card">
            <div class="empty-state">
                <div class="empty-state-icon">📋</div>
                <div class="empty-state-text">No logs available</div>
            </div>
        </div>
        """)

    # ============================================================
    # ACTIVE PARAMETERS
    # ============================================================
    params = param_state.get("params", {})
    if params:
        st.html('<div class="section-header">ACTIVE PARAMETERS</div>')
        
        param_html = '<div class="metric-card" style="padding:0; overflow:hidden;">'
        for i, (k, v) in enumerate(params.items()):
            border_style = "" if i == len(params) - 1 else "border-bottom: 1px solid var(--border);"
            param_html += f"""
            <div style="display:flex; justify-content:space-between; align-items:center;
                        padding:12px 20px; {border_style}">
                <span style="color:var(--text-secondary); font-size:0.85rem; font-family:'Inter', sans-serif;">
                    {k.replace('_', ' ').title()}
                </span>
                <span style="color:var(--cyan); font-family:'JetBrains Mono', monospace; font-weight:500;">
                    {v}
                </span>
            </div>
            """
        
        param_html += '</div>'
        st.html(param_html)

    # ============================================================
    # FOOTER
    # ============================================================
    st.html(f"""
    <div style="color:var(--text-muted); font-size:0.7rem; text-align:center; 
